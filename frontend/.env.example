# Digital Risk Protection Platform - Environment Configuration
# Copy this file to .env.local to configure your local development environment

# Backend API Base URL
# Default points to teammate's local FastAPI backend server
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request Timeout in Milliseconds
VITE_API_TIMEOUT_MS=6000

# SECURITY NOTE:
# Never expose Hugging Face, OpenAI, database credentials, or secret keys in client-side code.
# All ML models, token authentication, and scraper API keys must be kept securely inside the FastAPI backend.
