# ============================================================================
# Digital Risk Protection (DRP) Backend Environment Configuration
# ============================================================================

# Application Settings
APP_NAME="Digital Risk Protection API"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
SECRET_KEY=dev-secret-key-change-in-production-drp-2026

# Database Connection (SQLite default for zero-friction local development & hackathon)
DATABASE_URL=sqlite:///./drp.db

# CORS Allowed Origins (Comma-separated string or list)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:4173,http://127.0.0.1:8080

# Teammate Integration Settings (Optional: backend runs with deterministic fallback if unset)
AI_MODULE_URL=
AI_MODULE_API_KEY=
MONITORING_MODULE_URL=
MONITORING_MODULE_API_KEY=
MODULE_REQUEST_TIMEOUT=3.0
