# Application Configuration
APP_NAME="Digital Risk Protection API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Configuration
DATABASE_URL="sqlite:///./digital_risk_protection.db"

# Detection Engine Mode: "rule_based" or "ai_hybrid"
DETECTION_ENGINE_MODE="rule_based"

# CORS Configuration
# Comma-separated list or JSON array of allowed frontend origins.
# Development defaults: Angular (4200), React/Next/Vite (3000, 5173).
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Production note: wildcard '*' is automatically forbidden in production mode.
# In production, set APP_ENV="production" and provide your explicit domain:
# APP_ENV="production"
# CORS_ORIGINS=["https://app.digitalriskprotection.com"]
