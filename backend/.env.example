# Application Configuration
APP_NAME=Digital Risk Protection API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins allowed for frontend development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:4173

# Database (SQLite default for simple local setup)
DATABASE_URL=sqlite:///./drp.db

# Security & Secrets
SECRET_KEY=dev-secret-key-change-in-production-drp-2026
